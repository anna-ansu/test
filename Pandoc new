FROM registry.local/python:3.12-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y pandoc && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir \
    -r requirements.txt

COPY . .

ENTRYPOINT ["python", "src/main.py"]
```

